# PostgreSQL used by Docker Compose
POSTGRES_DB=budget_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_local_password

# Datasource used by Spring Boot when running from the host machine
DB_URL=jdbc:postgresql://localhost:5432/budget_ai
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_local_password

# OpenAI
OPENAI_API_KEY=replace_with_your_api_key

# Authentication and legacy data migration
JWT_SECRET=replace_with_a_base64_encoded_32_byte_secret
JWT_EXPIRATION_SECONDS=3600
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_initial_password

# HTTP and browser access
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_READ_TIMEOUT=30s